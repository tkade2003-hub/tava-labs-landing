pe=\"button\" data-value=\"fine_lines\"><span class=\"t\">Jemné vrásky</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"hydration\"><span class=\"t\">Hloubková hydratace</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"even_tone\"><span class=\"t\">Sjednocený tón</span></button>\n    </div>\n  </section>\n\n  <!-- 3 · INTERSTITIAL 1 -->\n  <section class=\"screen\" data-screen=\"notalone\" data-progress=\"24\">\n    <p class=\"eyebrow\">Nejste v tom sami</p>\n    <h2 id=\"naTitle\">Nejste v tom sami.</h2>\n    <p class=\"lede\" id=\"naBody\"></p>\n    <button class=\"cta\" type=\"button\" data-next>Pokračovat</button>\n  </section>\n\n  <!-- 4 · Q2 SKIN TYPE -->\n  <section class=\"screen\" data-screen=\"skinType\" data-progress=\"34\" data-step-label=\"Zbývá 5\">\n    <h2>Jak se vaše pleť obvykle cítí v polovině dne?</h2>\n    <div class=\"choices\" data-choice-group=\"skinType\">\n      <button class=\"choice\" type=\"button\" data-value=\"dry\"><span class=\"t\">Suchá</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"oily\"><span class=\"t\">Mastná</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"combination\"><span class=\"t\">Smíšená</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"sensitive\"><span class=\"t\">Citlivá</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"not_sure\"><span class=\"t\">Nejsem si jistý</span></button>\n    </div>\n  </section>\n\n  <!-- 5 · Q3 CONCERN -->\n  <section class=\"screen\" data-screen=\"concern\" data-progress=\"46\" data-step-label=\"Zbývá 4\">\n    <h2>A co vás právě teď trápí nejvíce?</h2>\n    <div class=\"choices\" data-choice-group=\"concern\">\n      <button class=\"choice\" type=\"button\" data-value=\"dullness\"><span class=\"t\">Mdlý vzhled</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"fine_lines\"><span class=\"t\">Jemné vrásky</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"uneven_tone\"><span class=\"t\">Nerovnoměrný tón</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"texture\"><span class=\"t\">Hrubá textura</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"dryness\"><span class=\"t\">Suchost</span></button>\n    </div>\n  </section>\n\n  <!-- 6 · INTERSTITIAL 2 · FORMULA MATCH -->\n  <section class=\"screen\" data-screen=\"match\" data-progress=\"56\">\n    <p class=\"eyebrow\">Vaše shoda složení</p>\n    <h2>Uvnitř lahvičky, přizpůsobeno vašim odpovědím</h2>\n    <p class=\"lede\" style=\"margin-bottom:2px;\">Jedno pevné složení. Zde jsou složky, které odpovídají tomu, co jste nám právě řekli.</p>\n    <div class=\"cardbox\" id=\"matchBox\"></div>\n    <button class=\"cta\" type=\"button\" data-next>Pokračovat</button>\n  </section>\n\n  <!-- 7 · Q4 SENSITIVITY -->\n  <section class=\"screen\" data-screen=\"sensitivity\" data-progress=\"64\" data-step-label=\"Zbývá 3\">\n    <h2>Reagovala vaše pleť někdy dříve na silné produkty?</h2>\n    <div class=\"choices\" data-choice-group=\"sensitivity\">\n      <button class=\"choice\" type=\"button\" data-value=\"often\"><span class=\"t\">Ano, snadno</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"sometimes\"><span class=\"t\">Někdy</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"never\"><span class=\"t\">Zřídka</span></button>\n    </div>\n  </section>\n\n  <!-- 8 · Q5 ROUTINE -->\n  <section class=\"screen\" data-screen=\"routine\" data-progress=\"74\" data-step-label=\"Zbývá 2\">\n    <h2>Jak vypadá vaše péče dnes?</h2>\n    <div class=\"choices\" data-choice-group=\"routine\">\n      <button class=\"choice\" type=\"button\" data-value=\"cleanser_only\"><span class=\"t\">Pouze čisticí přípravek</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"few_products\"><span class=\"t\">Několik produktů</span></button>\n      <button class=\"choice\" type=\"button\" data-value=\"full_routine\"><span class=\"t\">Kompletní péče</span></button>\n    </div>\n  </section>\n\n  <!-- 9 · Q6 ROUTINE TIMES -->\n  <section class=\"screen\" data-screen=\"times\" data-progress=\"84\" data-step-label=\"Poslední otázka\">\n    <h2>Kdy jej budete aplikovat?</h2>\n    <label class=\"f\">Ráno</label>\n    <div class=\"chips\" data-time-chips=\"amTime\">\n      <button class=\"chip\" type=\"button\" data-value=\"06:30\">6:30 AM</button>\n      <button class=\"chip\" type=\"button\" data-value=\"07:30\">7:30 AM</button>\n      <button class=\"chip\" type=\"button\" data-value=\"08:30\">8:30 AM</button>\n    </div>\n    <input type=\"time\" id=\"amCustom\" aria-label=\"Vlastní ranní čas\" style=\"margin-top:10px;\">\n    <label class=\"f\">Večer</label>\n    <div class=\"chips\" data-time-chips=\"pmTime\">\n      <button class=\"chip\" type=\"button\" data-value=\"21:00\">9:00 PM</button>\n      <button class=\"chip\" type=\"button\" data-value=\"22:00\">10:00 PM</button>\n      <button class=\"chip\" type=\"button\" data-value=\"22:30\">10:30 PM</button>\n    </div>\n    <input type=\"time\" id=\"pmCustom\" aria-label=\"Vlastní večerní čas\" style=\"margin-top:10px;\">\n    <div style=\"height:22px\"></div>\n    <button class=\"cta\" type=\"button\" data-next>Pokračovat</button>\n  </section>\n\n  <!-- 10 · EMAIL -->\n  <section class=\"screen\" data-screen=\"email\" data-progress=\"92\" data-step-label=\"Už skoro hotovo\">\n    <h2>Kam máme zaslat váš třicetidenní plán?</h2>\n    <p class=\"lede\">Váš plán jde do vaší schránky. Při stahování aplikace použijte stejný e-mail, protože tak vás aplikace pozná, a vaše odpovědi, plán a objednávka tam na vás budou čekat.</p>\n    <label class=\"f\" for=\"emailInput\">E-mailová adresa</label>\n    <input type=\"email\" id=\"emailInput\" autocomplete=\"email\" placeholder=\"you@example.com\">\n    <div class=\"banner err\" id=\"emailErr\">Tento e-mail nevypadá úplně. Zkontrolujte ho a zkuste to znovu.</div>\n    <div style=\"height:18px\"></div>\n    <button class=\"cta\" type=\"button\" id=\"emailNext\">Zobrazit můj plán</button>\n  </section>\n\n  <!-- 11 · PLAN REVEAL — treatment preview -->\n  <section class=\"screen\" data-screen=\"plan\" data-progress=\"97\" data-step-label=\"Váš plán\">\n    <div class=\"planhero\">\n      <p class=\"plan-eyebrow\">Náhled vaší péče</p>\n      <p class=\"plan-brand\">Tava Labs</p>\n      <h2 id=\"planTitle\">PDRN Brightening Serum</h2>\n      <div class=\"plan-bottle\"><img src=\"/assets/products/pdrn-bright-serum/view-1-mockup.jpg\" alt=\"PDRN Brightening Serum bottle\"></div>\n      <p class=\"basedon\">Vybráno na základě vašich cílů:</p>\n      <div class=\"goalchips\" id=\"goalChips\"></div>\n      <p class=\"priceline\">Plány od <strong>$39/month*</strong></p>\n      <p class=\"fineprint\">*Placeno měsíčně. Kdykoli lze pozastavit nebo zrušit.<br>Jednorázová lahvička $49.</p>\n    </div>\n    <div class=\"cardbox\" style=\"margin-top:14px\">\n        <p style=\"font-family:Kanit,sans-serif;font-size:12px;font-weight:600;letter-spacing:2.5px;color:#B78B45;margin:0 0 8px\">VÁŠ PRVNÍ TÝDEN</p>\n        <p style=\"margin:0 0 14px\">Vaše odpovědi už určily první týden vaší péče. Po prvních dvou dnech zbývá pět dní a první den začíná ve chvíli, kdy vaše sérum odešleme.</p>\n        <div style=\"display:flex;gap:8px\" aria-hidden=\"true\">\n          <span style=\"flex:1;text-align:center;padding:9px 0;border-radius:10px;background:#123B2C;color:#D8C19A;font-family:Kanit,sans-serif;font-weight:600;font-size:13px\">Den 1</span>\n          <span style=\"flex:1;text-align:center;padding:9px 0;border-radius:10px;background:#123B2C;color:#D8C19A;font-family:Kanit,sans-serif;font-weight:600;font-size:13px\">Den 2</span>\n          <span style=\"flex:1;text-align:center;padding:9px 0;border-radius:10px;border:1.5px solid rgba(18,16,12,.25);font-family:Kanit,sans-serif;font-weight:600;font-size:13px\">Den 3</span>\n          <span style=\"flex:1;text-align:center;padding:9px 0;border-radius:10px;border:1.5px solid rgba(18,16,12,.25);font-family:Kanit,sans-serif;font-weight:600;font-size:13px\">Den 4</span>\n          <span style=\"flex:1;text-align:center;padding:9px 0;border-radius:10px;border:1.5px solid rgba(18,16,12,.25);font-family:Kanit,sans-serif;font-weight:600;font-size:13px\">Den 5</span>\n          <span style=\"flex:1;text-align:center;padding:9px 0;border-radius:10px;border:1.5px solid rgba(18,16,12,.25);font-family:Kanit,sans-serif;font-weight:600;font-size:13px\">Den 6</span>\n          <span style=\"flex:1;text-align:center;padding:9px 0;border-radius:10px;border:1.5px solid rgba(18,16,12,.25);font-family:Kanit,sans-serif;font-weight:600;font-size:13px\">Den 7</span>\n        </div>\n      </div>\n      <div class=\"cardbox detailscard\">\n      <h3>Podrobnosti o séru</h3>\n      <p>Jedno sérum. Dvakrát denně. 30 dní.</p>\n      <div class=\"stats\">\n        <div class=\"stat\"><span class=\"sk\">Typ</span><span class=\"sv\">Rozjasňující sérum · 1 fl oz</span></div>\n        <div class=\"stat\"><span class=\"sk\">Použití</span><span class=\"sv\">Dvakrát denně</span></div>\n        <div class=\"stat\"><span class=\"sk\">Plán</span><span class=\"sv\">30 dní</span></div>\n      </div>\n      <div id=\"planBox\"></div>\n      <details class=\"acc\" open>\n        <summary>Aktivní složky</summary>\n        <div class=\"ingcards\" role=\"list\" aria-label=\"Aktivní složky\">\n          <div class=\"ingcard\" role=\"listitem\"><span class=\"name\">PDRN</span><span class=\"sub\">Polydeoxyribonukleotid</span><img class=\"ingimg\" src=\"/assets/ingredients/ingredient-pdrn.png\" alt=\"Textura séra PDRN\" loading=\"lazy\"><p class=\"benefit\">Pro pleť, která vypadá jasnější</p></div>\n          <div class=\"ingcard\" role=\"listitem\"><span class=\"name\">Acetyl Hexapeptide-8</span><span class=\"sub\">Peptid</span><img class=\"ingimg\" src=\"/assets/ingredients/ingredient-peptide.png\" alt=\"Textura séra s Acetyl Hexapeptide-8\" loading=\"lazy\"><p class=\"benefit\">Pro hladčeji vypadající pleť</p></div>\n          <div class=\"ingcard\" role=\"listitem\"><span class=\"name\">Sodium Hyaluronate</span><span class=\"sub\">Kyselina hyaluronová</span><img class=\"ingimg\" src=\"/assets/ingredients/ingredient-ha.png\" alt=\"Textura séra se Sodium Hyaluronate\" loading=\"lazy\"><p class=\"benefit\">Pro hlubokou hydrataci</p></div>\n          <div class=\"ingcard\" role=\"listitem\"><span class=\"name\">Panthenol</span><span class=\"sub\">Provitamin B5</span><div class=\"ingtex\" aria-hidden=\"true\"></div><p class=\"benefit\">Pro jemnou a příjemnou pleť</p></div>\n        </div>\n        <p class=\"ingnote\">Kosmetické sérum k místnímu použití. Pouze k vnějšímu použití. Vyhněte se očím. Při podráždění přestaňte používat.</p>\n      </details>\n      <details class=\"acc\">\n        <summary>Jak používat</summary>\n        <p>Aplikujte 2 až 4 pumpičky na čistou, suchou pleť dvakrát denně. Ráno pokračujte hydratačním krémem nebo opalovacím krémem.</p>\n      </details>\n      <details class=\"acc\">\n        <summary>Dobré vědět</summary>\n        <p>Pouze k vnějšímu použití. Vyhněte se očím. Při podráždění přestaňte používat. Uchovávejte mimo dosah dětí. Nepoužívejte na porušenou pokožku. Skladujte na chladném a suchém místě.</p>\n      </details>\n    </div>\n    <div class=\"featureband\">\n      <h3>Poznejte své <em>sérum</em></h3>\n      <div class=\"feature\">\n        <img src=\"/assets/products/pdrn-bright-serum/view-1-mockup.jpg\" alt=\"Lahvička produktu PDRN Brightening Serum\">\n        <span class=\"callout c1\">Prezentace a jas</span>\n        <span class=\"callout c2\">Hloubková hydratace</span>\n        <span class=\"callout c3\">Jemné vrásky</span>\n      </div>\n    </div>\n    <h3 class=\"featuretitle\">Skutečné výsledky</h3>\n    <div class=\"results\